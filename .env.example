# Faregate gateway configuration.
#
# Copy to .env and fill in what you have. Every subsystem below is optional:
# the gateway starts without any of them and reports itself as `simulated` on
# /health and in the dashboard. It never presents simulated output as real.
#
# Never commit a filled-in .env. It is gitignored for a reason.

# --- gateway -----------------------------------------------------------------
PORT=8402
FAREGATE_CORS_ORIGIN=http://localhost:3000

# --- payment: x402 on Hedera -------------------------------------------------
# CAIP-2 network id. `hedera:testnet` and `hedera:mainnet` are supported by
# @x402/hedera. Keep this on testnet for the demo.
FAREGATE_NETWORK=hedera:testnet

# Facilitator that verifies and settles payments.
#   Blocky402 hosted testnet:  https://api.blocky402.com
#   x402.org reference:        https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.blocky402.com

# Hedera account that receives fares, for example 0.0.12345.
# Without this the payment subsystem stays in simulated mode.
FAREGATE_PAY_TO=

# Asset to charge in. 0.0.0 is native HBAR and needs no token association.
# Testnet USDC is 0.0.429274 and requires both accounts to be associated.
FAREGATE_ASSET=0.0.429274

# How long a quoted price stays valid, in seconds.
FAREGATE_PAYMENT_TIMEOUT_SECONDS=120

# --- data: The Graph ---------------------------------------------------------
# API key from Subgraph Studio. Without a key or a pinned URL the data
# subsystem stays in simulated mode.
GRAPH_API_KEY=
# Optional: pin a full subgraph query URL instead of composing one.
GRAPH_SUBGRAPH_URL=

# --- ai ----------------------------------------------------------------------
# Used only to interpret requests and summarise retrieved data. The model never
# decides policy and is never the source of a blockchain fact.
ANTHROPIC_API_KEY=
FAREGATE_AI_MODEL=claude-sonnet-5

# --- identity: ENS -----------------------------------------------------------
# Sepolia RPC used to resolve agent passports. Without it, passports resolve
# from the gateway's local store.
ENS_RPC_URL=
FAREGATE_PARENT_NAME=agents.faregate.eth

# --- agent client ------------------------------------------------------------
# Only the demo agent needs these, and only to pay for its own queries.
# This is a throwaway testnet key. Never put a mainnet key here.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
FAREGATE_GATEWAY_URL=http://localhost:8402
