{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "faregate-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/api/src/server.ts"
      ],
      "port": 8402
    },
    {
      "name": "faregate-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@faregate/web"
      ],
      "port": 3000
    }
  ]
}
