{
  "name": "faregate",
  "version": "0.1.0",
  "private": true,
  "description": "A permission and payment gateway for AI agents that need access to onchain data.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace @faregate/api",
    "dev:web": "npm run dev --workspace @faregate/web",
    "agent": "node apps/agent/src/index.ts",
    "check": "npm run typecheck && npm test && npm run lint && npm run build",
    "ens:passport": "node scripts/ens/passport.ts",
    "ens:setup": "node scripts/ens/setup.ts",
    "ens:revoke": "node scripts/ens/passport.ts revoke --send --name",
    "ens:restore": "node scripts/ens/setup.ts --send",
    "e2e:live": "node scripts/e2e/live.ts",
    "hedera:usdc": "node scripts/hedera/usdc.ts",
    "hedera:create-gateway": "node scripts/hedera/create-gateway.ts",
    "reset": "node -e \"require('fs').rmSync('data/faregate-state.json',{force:true});console.log('gateway state cleared')\""
  },
  "devDependencies": {
    "@hiero-ledger/sdk": "2.85.0"
  }
}
