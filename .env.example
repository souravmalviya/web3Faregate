# Faregate gateway configuration.
#
# Copy to .env and fill in what you have. Every subsystem below is optional:
# the gateway starts without any of them and reports itself as `simulated` on
# /health and in the dashboard. It never presents simulated output as real.
#
# Never commit a filled-in .env. It is gitignored for a reason.

# --- gateway -----------------------------------------------------------------
PORT=8402
FAREGATE_CORS_ORIGIN=http://localhost:3000

# Human actions (approve, reject, revoke, policy changes, new agents) must be
# signed by the acting wallet and are verified by the gateway. Set to false
# only for local API experiments without a wallet.
FAREGATE_REQUIRE_SIGNED_ACTIONS=true

# Where gateway state is kept between restarts, relative to the repository
# root. `off` keeps everything in memory. Delete the file to reset the demo.
FAREGATE_STATE_FILE=data/faregate-state.json

# Requests each agent may submit per minute, and human actions each caller
# may perform per minute.
FAREGATE_RATE_LIMIT_REQUESTS_PER_MINUTE=60
FAREGATE_RATE_LIMIT_ACTIONS_PER_MINUTE=30

# --- payment: x402 on Hedera -------------------------------------------------
# CAIP-2 network id. `hedera:testnet` and `hedera:mainnet` are supported by
# @x402/hedera. Keep this on testnet for the demo.
FAREGATE_NETWORK=hedera:testnet

# Facilitator that verifies and settles payments. Leave empty to use Blocky402
# for the configured network:
#   hedera:testnet  https://api.testnet.blocky402.com
#   hedera:mainnet  https://api.blocky402.com
# The gateway checks the facilitator supports the network before it starts.
X402_FACILITATOR_URL=

# Hedera account that receives fares. Without it payments stay simulated.
# Create it from your agent account with: npm run hedera:create-gateway -- --send
FAREGATE_PAY_TO=
# Written by hedera:create-gateway. Only the Hedera scripts read it; the
# gateway never does. Testnet only.
FAREGATE_PAY_TO_PRIVATE_KEY=

# Asset to charge in. 0.0.0 is native HBAR and needs no token association.
# Testnet USDC is 0.0.429274. An account can receive it once associated, or
# automatically if it has free association slots; hedera:usdc status checks.
FAREGATE_ASSET=0.0.429274

# How long a quoted price stays valid, in seconds.
FAREGATE_PAYMENT_TIMEOUT_SECONDS=120

# --- data: The Graph ---------------------------------------------------------
# API key from Subgraph Studio. Without it the data subsystem stays simulated.
GRAPH_API_KEY=
# Protocol subgraphs, all publishing the Messari standard lending schema, as
# `protocol=subgraphIdOrUrl` pairs. One query document fans out across every
# protocol listed here; an agent that names a protocol gets that one only.
# Example: GRAPH_SUBGRAPHS=aave-v3=<subgraph id>,compound-v3=<subgraph id>
# Messari registry ids, Ethereum mainnet, schema 3.1.0: aave-v3-ethereum,
# compound-v3-ethereum, spark-lend-ethereum. One query spans all three.
GRAPH_SUBGRAPHS=aave-v3=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk,compound-v3=AwoxEZbiWLvv6e3QdvdMZw4WDURdGbvPfHmZRc8Dpfz9,spark-lend=GbKdmBe4ycCYCQLQSjqGg6UHYoYfbyJyq5WrG35pv1si
# Single-subgraph shorthand, used only when GRAPH_SUBGRAPHS is not set.
GRAPH_SUBGRAPH_ID=
GRAPH_SUBGRAPH_URL=

# --- ai ----------------------------------------------------------------------
# OpenRouter key, used only to interpret requests and summarise retrieved data.
# The model never decides policy and is never the source of a blockchain fact.
# Without a key, requests are parsed by the rule-based fallback.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports structured outputs. The default costs
# well under a cent per Faregate request.
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- identity: ENS -----------------------------------------------------------
# Sepolia RPC used to resolve agent passports. Read-only, so a public endpoint
# works: https://ethereum-sepolia-rpc.publicnode.com
# Without it, passports resolve from the gateway's local store.
ENS_RPC_URL=
# Names under this parent are ENS passports. When ENS is configured they are
# resolved live on every request and fail closed if the chain is unreachable.
FAREGATE_PARENT_NAME=agents.faregate.eth
# ENSv2 beta Universal Resolver on Sepolia. Defaults to the address on the ENS
# deployments page; override only if ENS redeploys.
ENS_UNIVERSAL_RESOLVER=
# Used only by scripts/ens (npm run ens:setup, npm run ens:passport), never by
# the gateway. Key of a fresh Sepolia test account that owns the passports; it
# must never hold real funds. 0x prefix optional.
ENS_OWNER_PRIVATE_KEY=
# Optional Sepolia RPC for npm run ens:setup. Kept apart from ENS_RPC_URL,
# which switches the gateway to ENS. Defaults to a public endpoint.
ENS_SETUP_RPC_URL=

# --- agent client ------------------------------------------------------------
# Only the demo agent needs these, and only to pay for its own queries.
# This is a throwaway testnet key. Never put a mainnet key here.
HEDERA_ACCOUNT_ID=
# HEX or DER encoding from the Hedera portal. Testnet only.
HEDERA_PRIVATE_KEY=
FAREGATE_GATEWAY_URL=http://localhost:8402
